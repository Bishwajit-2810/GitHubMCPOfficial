# ── GitHub (MCP server + BFF tools) ──────────────────────────────────────────
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
PROJECT_ID=1

# ── Firebase (BFF auth) — one of these two is required ───────────────────────
# Supported sign-in methods: Google and Email/Password only.
# GitHub is NOT a Firebase sign-in provider — it is only used post-login
# via the "Connect GitHub" OAuth flow below to grant API tool access.
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccount.json
# FIREBASE_PROJECT_ID=your-firebase-project-id   # alternative: Application Default Credentials

# ── JWT (BFF — signed token returned to Flutter) ─────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600           # seconds, default 3600 (1 hour)

# ── Fernet key (encrypts stored GitHub OAuth tokens) ─────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-fernet-key-here

# ── GitHub OAuth App (post-login "Connect GitHub" — grants repo/read:org/project scopes for tools) ──
# This is NOT used for login. Users log in via Google or email/password (Firebase),
# then connect GitHub separately to enable the task and codebase tools.
#
# IMPORTANT: In GitHub OAuth App settings (github.com → Settings → Developer settings → OAuth Apps),
# register ALL callback URLs you'll use — one per line:
#   githubmcp://oauth/callback          ← Android deep link
#   http://localhost:8080/auth.html     ← Flutter web dev (default port)
#   http://localhost:<PORT>/auth.html   ← any other Flutter web port you use
#   https://yourdomain.com/auth.html    ← production web
#
# The backend accepts both githubmcp:// and any localhost http/https URI.
# Override the default below with --dart-define=GITHUB_REDIRECT_URI=... on the Flutter side.
GITHUB_CLIENT_ID=Ov23li...
GITHUB_CLIENT_SECRET=your-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8091/api/v1/auth/github/callback

# ── Database (BFF + RAG PGVector) ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/githubmcp
POSTGRES_URL=postgresql://postgres:postgres@localhost:5434/githubmcp
# SQLite alternative (local dev, no Docker): DATABASE_URL=sqlite:///./dev.db

# ── RAG / AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key
RAG_VECTOR_DB=pgvector         # chroma | pgvector | both
RAG_CHROMA_DIR=./chroma_store
RAG_SKIP_LOCAL_DOCS=true

# ── BFF Server ────────────────────────────────────────────────────────────────
API_PORT=8091
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FLUTTER_WEB_ORIGIN=http://localhost:5173   # used by /auth/github/callback to redirect back to auth.html
LOG_LEVEL=INFO
